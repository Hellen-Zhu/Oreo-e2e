# ── BLOTTER MARKETPLACE DIALOG COMPONENT ────────────────────────────

@Then "^component blotter marketplace dialog is visible$"
    Then assert that 'blotter_marketplace_dialog.dialog' is eventually visible

@When "^component blotter marketplace searches by stored variable '([^']*)'$"
    When type inner value '$1' from stored variable into 'blotter_marketplace_dialog.search_input'

@Then "^component blotter marketplace table contains read-only row for stored variable '([^']*)'$"
    Then assert that 'blotter_marketplace_dialog.table' eventually contains from stored variable '$1'
    And assert that 'blotter_marketplace_dialog.table' eventually contains 'Marketplace'
    And assert that 'blotter_marketplace_dialog.table' eventually contains 'Read only'
