@When "^perform the Early Termination event on the '([^']*)' trade$"
    When opens lifecycle action 'early termination' for current trade
    And component dynamic action selects direction from stored variable 'earlyTermination.direction'
    And component dynamic action types amount from stored variable 'earlyTermination.amount'
    And component dynamic action types currency from stored variable 'earlyTermination.ccy'
    And submits lifecycle event and waits for page ready

@Then "^the early termination is completed successfully$"
    Then assert toast notification with type 'success' and message 'EarlyTermination completed successfully'

@Then "^the trade is closed as Terminated$"
    Then page trade portal blotter row of trade stored as 'createdTradeId' shows status 'DEAD' and event status 'Terminated'
