# ── Build request ───────────────────────────────────────────────────
@Given "^start a new api request as user '([^']*)'$"
    Given start building a new request
    And set the user header for '$1'
    And set a new request id header

@Given "^build json request with body from test data '([^']*)'$"
    Given start a new api request as user 'maker'
    And set the payload content type to 'application/json'
    And set request body from test data '$1'

@Given "^build json request with body from test data '([^']*)' at json path '([^']*)' from stored variable '([^']*)'$"
    Given start a new api request as user 'maker'
    And set the payload content type to 'application/json'
    And set json request body from test data '$1' at json path '$2' from stored variable '$3'

@Given "^build json request with body from test data '([^']*)' as user '([^']*)'$"
    Given start a new api request as user '$2'
    And set the payload content type to 'application/json'
    And set request body from test data '$1'

@Given "^build json request with body from current scenario$"
    Given start a new api request as user 'maker'
    And set the payload content type to 'application/json'
    And set request body from current scenario

@Given "^build json request with body from current scenario at json path '([^']*)' from stored variable '([^']*)'$"
    Given start a new api request as user 'maker'
    And set the payload content type to 'application/json'
    And set json request body from current scenario at json path '$1' from stored variable '$2'

@Given "^build json request with body from current scenario at json path '([^']*)' from stored variable '([^']*)' as user '([^']*)'$"
    Given start a new api request as user '$3'
    And set the payload content type to 'application/json'
    And set json request body from current scenario at json path '$1' from stored variable '$2'

@Given "^build json request with body from current scenario as user '([^']*)'$"
    Given start a new api request as user '$1'
    And set the payload content type to 'application/json'
    And set request body from current scenario

@Given "^build request as user '([^']*)'$"
    Given start a new api request as user '$1'

@Given "^build json request with path parameter '([^']*)' from stored variable '([^']*)' as user '([^']*)'$"
    Given start a new api request as user '$3'
    And set header 'Content-Type' to 'application/json'
    And set path parameter '$1' from stored variable '$2'

@Given "^build json request from test data '([^']*)' with trade id from stored variable '([^']*)' as user '([^']*)'$"
    Given start a new api request as user '$3'
    And set header 'Content-Type' to 'application/json'
    And set json request body from test data '$1' with trade id from stored variable '$2'

@Given "^build json request from current scenario with trade id from stored variable '([^']*)' as user '([^']*)'$"
    Given start a new api request as user '$2'
    And set header 'Content-Type' to 'application/json'
    And set json request body from current scenario with trade id from stored variable '$1'

@Given "^build multipart request with parameter '([^']*)' from test data '([^']*)' for product '([^']*)' as user '([^']*)'$"
    Given start a new api request as user '$4'
    And set multi-part form parameter '$1' for product '$3' from test data '$2'
    And set multi-part dat file for product '$3'

@Given "^build multipart request with parameter '([^']*)' from current scenario for product '([^']*)' as user '([^']*)'$"
    Given start a new api request as user '$3'
    And set multi-part form parameter '$1' for product '$2' from current scenario
    And set multi-part dat file for product '$2'

@Given "^build json request from current scenario with task ids from stored variables '([^']*)' and '([^']*)' as user '([^']*)'$"
    Given start a new api request as user '$3'
    And set header 'Content-Type' to 'application/json'
    And set json request body from current scenario with task ids from stored variables '$1' and '$2'

@When "^get '([^']*)' with path parameter '([^']*)' from stored variable '([^']*)' as user '([^']*)'$"
    Given build json request with path parameter '$2' from stored variable '$3' as user '$4'
    When get from path '$1'

# ── Outcomes ────────────────────────────────────────────────────────

# The outcome of the request just sent, one vocabulary for every API. The quoted subject is for the reader; the
# outcome fixes the status, then the response is compared strictly with the case's recording
# (data/api/expected/<event>/<caseId>.json). A domain step exists only when it checks more than this.
# Example: the 'counterparties list' is retrieved successfully; the 'trade creation' request is rejected with permission
# denied; the 'Allocation' event is rejected with a validation error.

@Then "^the '([^']*)'(?: request)? (?:is|are) (?:retrieved|created|updated|approved|processed|executed) successfully$"
    Then response status code is '200'
    And response matches current scenario

@Then "^the '([^']*)' (?:request|event) is rejected with a validation error$"
    Then response status code is '400'
    And response matches current scenario

@Then "^the '([^']*)' (?:request|event) is rejected with permission denied$"
    Then response status code is '403'
    And response matches current scenario

@Then "^the '([^']*)' (?:request|event) is rejected as not found$"
    Then response status code is '404'
    And response matches current scenario

@Then "^the '([^']*)' (?:request|event) is rejected with a conflict$"
    Then response status code is '409'
    And response matches current scenario
