{
  "_comment": "features/api/trading/trade_creation.feature. Layers: defaults, byProduct, the case's row, the row's byProduct. API-001 has no row: it runs on the defaults. A variant's expected file may be a patch on the API-001 of its product (expectedBase; made by TestDataTool compact); cases without a product have no base.",
  "shared": {
    "trade-basic": {
      "_comment": "Trade body of POST /trades/create (part 'trade'); the step sets basic.productId from the product",
      "request": {
        "basic": {
          "counterpartyFmId": "900000001",
          "counterpartyName": "EXAMPLE COUNTERPARTY A",
          "portfolioId": "EXAMPLE_PORTFOLIO_A",
          "direction": "Buy",
          "premiumAmount": 10000,
          "premiumCurrency": "USD"
        }
      }
    },
    "stepin-partial": {
      "_comment": "StepIn Partial: the old counterparty and the novation date as udf entries; the date is today's, so its echo in the response (udf[3]) is masked",
      "request": {
        "basic": {
          "udf": [
            { "key": "stepInType", "value": "StepInPartial", "type": "Text" },
            { "key": "oldCptyName", "value": "EXAMPLE COUNTERPARTY B", "type": "Text" },
            { "key": "oldCptyFmId", "value": "900000002", "type": "Text" },
            { "key": "novationDate", "value": "${date:T}", "type": "Date" }
          ]
        }
      },
      "dynamicFields": { "data.trade.basic.udf[3].value": "type" }
    },
    "stepin-full": {
      "_comment": "StepIn Full: the old counterparty and the novation date as udf entries; the date is today's, so its echo in the response (udf[3]) is masked",
      "request": {
        "basic": {
          "udf": [
            { "key": "stepInType", "value": "StepInFull", "type": "Text" },
            { "key": "oldCptyName", "value": "EXAMPLE COUNTERPARTY B", "type": "Text" },
            { "key": "oldCptyFmId", "value": "900000002", "type": "Text" },
            { "key": "novationDate", "value": "${date:T}", "type": "Date" }
          ]
        }
      },
      "dynamicFields": { "data.trade.basic.udf[3].value": "type" }
    }
  },
  "defaults": {
    "use": ["trade-basic", "trade-response-parts"],
    "expectedBase": "TC-TRADE-CREATION-<product_type>-API-001",
    "dynamicFields": {
      "msg": "regex:Submitted for checker approval\\. TaskId: CHK-.*",
      "data.trade.id": "type",
      "data.checkerContext.taskId": "type"
    }
  },
  "byProduct": {
    "FX_TRF": {
      "dynamicFields": {
        "data.trade.instrument.version": "type",
        "data.trade.instrument.TRF.schedule": "type-tree",
        "data.trade.instrument.TRF.payoffDict": "type-tree",
        "data.trade.instrument.TRF.delivery.DD_Physical.dd_roundings": "type-tree"
      }
    },
    "FX_PSCRIPT": {
      "dynamicFields": {
        "data.trade.instrument.PayoffScript.trdData.DataRec.fixingSched.FS_SchedParams.fs_anchorDate": "type",
        "data.trade.instrument.PayoffScript.trdData.DataRec.fixingSched.FS_SchedParams.fs_end.SE_ByEndDate.se_endDate": "type"
      }
    },
    "FX_PSCRIPT_FSKO": {
      "dynamicFields": {
        "data.trade.basic.notionalAmount": "type",
        "data.trade.instrument.version": "type",
        "data.trade.instrument.PayoffScript": "type-tree"
      }
    },
    "FX_PSCRIPT_TRF": {
      "_comment": "Sold, without premium",
      "request": {
        "basic": { "direction": "Sell", "premiumAmount": null, "premiumCurrency": null }
      },
      "dynamicFields": {
        "data.trade.instrument": "type-tree",
        "data.trade.trace": "type-tree"
      }
    }
  },
  "cases": [
    {
      "id": "TC-TRADE-CREATION-<product_type>-API-002",
      "_comment": "StepIn Partial",
      "use": ["stepin-partial"],
      "byProduct": {
        "FX_PSCRIPT_TRF": { "request": { "basic": { "notionalCurrency": "" } } }
      }
    },
    {
      "id": "TC-TRADE-CREATION-<product_type>-API-003",
      "_comment": "StepIn Full",
      "use": ["stepin-full"],
      "byProduct": {
        "FX_PSCRIPT_TRF": { "request": { "basic": { "direction": "Buy", "notionalCurrency": "CNH" } } }
      }
    },
    {
      "id": "TC-TRADE-CREATION-API-004",
      "_comment": "Counterparty name absent: 400",
      "use": ["stepin-partial"],
      "request": { "basic": { "counterpartyFmId": "900000002", "counterpartyName": "" } },
      "dynamicFields": null
    },
    {
      "id": "TC-TRADE-CREATION-API-005",
      "_comment": "Portfolio absent: 400",
      "use": ["stepin-full"],
      "request": { "basic": { "portfolioId": "" } },
      "dynamicFields": null
    },
    {
      "id": "TC-TRADE-CREATION-API-006",
      "_comment": "A user without the Maker role submits: 403",
      "dynamicFields": null
    }
  ]
}
