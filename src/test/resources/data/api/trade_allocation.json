{
  "_comment": "features/api/trading/trade_allocation.feature. Body of POST /trades/trigger-event; the step replaces tradeIds with the created trade. The defaults are the 2-way equal split of an FX_TRF trade (notional 70000), the trade of every case without a product. The amounts must sum to the trade's notional, which comes from the product's dat file: API-001 and API-002 give every product of the allocation capability its own split in their byProduct, and a new product needs one there too.",
  "defaults": {
    "expectedBase": "TC-TRADE-ALLOCATION-<product_type>-API-001",
    "request": {
      "eventType": "Allocation",
      "data": [
        { "key": "notionalAmounts", "value": "[35000, 35000]", "type": "Numeric Array" },
        { "key": "counterpartyIds", "value": "[\"900000003\", \"900000004\"]", "type": "Numeric Array" },
        { "key": "portfolioIds", "value": "[\"EXAMPLE_PORTFOLIO_B\", \"EXAMPLE_PORTFOLIO_C\"]", "type": "Numeric Array" }
      ],
      "reason": "NON_ECON_CHANGE",
      "comments": "Allocation split into 2 equal parts with distinct counterparties and portfolios",
      "tradeIds": ["PLACEHOLDER"]
    },
    "dynamicFields": {
      "msg": "type",
      "data.results[*].tradeId": "type",
      "data.results[*].childTradeIds[*]": "type"
    }
  },
  "cases": [
    {
      "id": "TC-TRADE-ALLOCATION-<product_type>-API-001",
      "_comment": "2-way equal split: 200 ALL_EXECUTED, two child trades",
      "byProduct": {
        "FX_PSCRIPT": {
          "_comment": "Notional 6937.5",
          "request": {
            "data": [
              { "key": "notionalAmounts", "value": "[3468.75, 3468.75]", "type": "Numeric Array" },
              { "key": "counterpartyIds", "value": "[\"900000003\", \"900000004\"]", "type": "Numeric Array" },
              { "key": "portfolioIds", "value": "[\"EXAMPLE_PORTFOLIO_B\", \"EXAMPLE_PORTFOLIO_C\"]", "type": "Numeric Array" }
            ]
          }
        },
        "FX_PSCRIPT_FSKO": {
          "_comment": "Notional 200000000",
          "request": {
            "data": [
              { "key": "notionalAmounts", "value": "[100000000, 100000000]", "type": "Numeric Array" },
              { "key": "counterpartyIds", "value": "[\"900000003\", \"900000004\"]", "type": "Numeric Array" },
              { "key": "portfolioIds", "value": "[\"EXAMPLE_PORTFOLIO_B\", \"EXAMPLE_PORTFOLIO_C\"]", "type": "Numeric Array" }
            ]
          }
        }
      }
    },
    {
