              { "key": "portfolioIds", "value": "[\"EXAMPLE_PORTFOLIO_B\", \"EXAMPLE_PORTFOLIO_C\", \"EXAMPLE_PORTFOLIO_B\"]", "type": "Numeric Array" }
            ],
            "comments": "3-way unequal split: 60% / 30% / 10% of notional 70000"
          }
        },
        "FX_PSCRIPT": {
          "request": {
            "data": [
              { "key": "notionalAmounts", "value": "[3000, 2000, 1937.5]", "type": "Numeric Array" },
              { "key": "counterpartyIds", "value": "[\"900000003\", \"900000004\", \"900000003\"]", "type": "Numeric Array" },
              { "key": "portfolioIds", "value": "[\"EXAMPLE_PORTFOLIO_B\", \"EXAMPLE_PORTFOLIO_C\", \"EXAMPLE_PORTFOLIO_D\"]", "type": "Numeric Array" }
