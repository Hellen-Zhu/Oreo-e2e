{
  "_comment": "features/api/trading/trade_allocation.feature. Body of POST /trades/trigger-event; the step replaces tradeIds with the created trade. A success records the allocated trade retrieved after the event (retrieved-trade); a rejection the event's response. API-001 and API-002 give the amounts as shares of the trade's notional ([60%, 30%, 10%]): the step reads the notional and sends the amounts, each rounded to the cent and the last one the rest, so no product needs data of its own. The defaults and the rejections give amounts for an FX_TRF trade (notional 70000).",
  "defaults": {
    "expectedBase": "TC-TRADE-ALLOCATION-<product_type>-API-001",
    "request": {
      "eventType": "Allocation",
      "data": [
        { "key": "notionalAmounts", "value": "[35000, 35000]", "type": "Numeric Array" },
        { "key": "counterpartyIds", "value": "[\"900000003\", \"900000004\"]", "type": "Numeric Array" },
        { "key": "portfolioIds", "value": "[\"EXAMPLE_PORTFOLIO_B\", \"EXAMPLE_PORTFOLIO_C\"]", "type": "Numeric Array" }
      ],
      "reason": "NON_ECON_CHANGE",
      "comments": "Allocation split into 2 equal parts with distinct counterparties and portfolios",
      "tradeIds": ["PLACEHOLDER"]
    }
  },
  "cases": [
    {
      "id": "TC-TRADE-ALLOCATION-<product_type>-API-001",
      "_comment": "2-way equal split of the trade's notional, whatever the product: 200 ALL_EXECUTED, two child trades; the recording is the allocated trade",
      "use": ["trade-response-parts", "retrieved-trade"],
      "request": {
        "data": [
          { "key": "notionalAmounts", "value": "[50%, 50%]", "type": "Numeric Array" },
          { "key": "counterpartyIds", "value": "[\"900000003\", \"900000004\"]", "type": "Numeric Array" },
          { "key": "portfolioIds", "value": "[\"EXAMPLE_PORTFOLIO_B\", \"EXAMPLE_PORTFOLIO_C\"]", "type": "Numeric Array" }
        ]
      }
    },
    {
      "id": "TC-TRADE-ALLOCATION-<product_type>-API-002",
      "_comment": "3-way unequal split of the trade's notional, whatever the product: 200 ALL_EXECUTED, three child trades; the recording is the allocated trade",
      "use": ["trade-response-parts", "retrieved-trade"],
      "request": {
        "data": [
          { "key": "notionalAmounts", "value": "[60%, 30%, 10%]", "type": "Numeric Array" },
          { "key": "counterpartyIds", "value": "[\"900000003\", \"900000004\", \"900000003\"]", "type": "Numeric Array" },
          { "key": "portfolioIds", "value": "[\"EXAMPLE_PORTFOLIO_B\", \"EXAMPLE_PORTFOLIO_C\", \"EXAMPLE_PORTFOLIO_B\"]", "type": "Numeric Array" }
