              { "key": "portfolioIds", "value": "[\"EXAMPLE_PORTFOLIO_B\", \"EXAMPLE_PORTFOLIO_C\", \"EXAMPLE_PORTFOLIO_B\"]", "type": "Numeric Array" }
            ],
            "comments": "3-way unequal split: 60% / 30% / 10% of notional 200000000"
          }
        }
      }
    },
