{
  "_comment": "The SIT seed's catalog (docs/sit-seed.md), read by SeedData. The seed features name each booking by composition and product ID. itradeableTypes: the Excel's full Itradeable Type (column E) of each composition the seed books, one to one ({\"<Itradeable Type>\": \"<composition>\"}). trades: a list of {composition, productId, taxonomy, dat, setup} for a pair (or a pair with one taxonomy) whose dat file name or body is not the default (a registered composition's dat is data/dat/<C>/<C>.dat, any other's seed/dat/<C>/<productId>.dat; the body is data/setup/trade-create). variants: another body for a pair, by name. events: the E2E Outline whose positive case's request books the event, via trigger-event (the default) or update (the amendment).",
  "itradeableTypes": {
    "Cortex.FX.FXVanilla.Tradeable.FXAccumulator":                  "FX_ACCUMULATOR",
    "Cortex.FX.FXVanilla.Tradeable.FXAverageRateOption":            "FX_ARO",
    "Cortex.FX.FXVanilla.Tradeable.FXAverageStrikeOption":          "FX_ASO",
    "Cortex.FX.FXStructured.Tradeable.FXBO":                        "FXBO",
    "Cortex.FX.FXStructured.Tradeable.FXFlexiForward":              "FX_FF",
    "Cortex.FX.FXVanilla.Tradeable.FXFVA":                          "FX_FVA",
    "Cortex.FX.FXStructured.Tradeable.FXOptionOnStructure":         "FX_OOS",
    "Cortex.Finance.Tradeable.PayoffScript.Ctrl.CorrOption":        "FX_CO",
    "Cortex.Finance.Tradeable.PayoffScript.Ctrl.CrossCurrency":     "FX_PSCRIPT_CCK",
    "Cortex.Finance.Tradeable.PayoffScript.Ctrl.FloatingStrikeB":   "FX_FSB",
    "Cortex.Finance.Tradeable.PayoffScript.Ctrl.FXBOBO":            "FX_PSCRIPT_BOBO",
    "Cortex.Finance.Tradeable.PayoffScript.Ctrl.TRFGeneric":        "FX_PSCRIPT_TRF",
    "Cortex.Finance.Tradeable.PayoffScript.Ctrl.VolBarrierDigi":    "FX_PSCRIPT_VBD",
    "Cortex.Finance.Tradeable.PayoffScript.Ctrl.FXEASO":            "FX_PSCRIPT_EASO",
    "Cortex.FX.FXVanilla.Tradeable.FXRangeAccrualOption":           "FX_RAO",
    "Cortex.FX.FXStructured.Tradeable.FXStructure":                 "FXStructure",
    "Cortex.Finance.Tradeable.TRF":                                 "FX_TRF",
    "Cortex.FX.FXVanilla.Tradeable.FXRealizedVolatilityOption":     "FX_RVO"
  },
  "trades": [],
  "variants": {
    "stepin-full": { "setup": "trade-create-stepin-full" },
    "stepin-partial": { "setup": "trade-create-stepin-partial" }
  },
  "events": {
    "allocation-full": { "case": "TC-TRADE-ALLOCATION-<product_type>-API-001" },
    "amendment": { "case": "TC-TRADE-AMENDMENT-<product_type>-API-001", "via": "update" },
    "withdrawal": { "case": "TC-TRADE-CANCELLATION-<product_type>-API-001" },
    "termination": { "case": "TC-TRADE-EARLY-TERMINATION-<product_type>-API-001" },
    "remaining-party-full": { "case": "TC-TRADE-NOVATION-REMAINING-<product_type>-API-001" },
    "remaining-party-partial": { "case": "TC-TRADE-PARTIAL-NOVATION-REMAINING-<product_type>-API-001" },
    "step-out-full": { "case": "TC-TRADE-STEP-OUT-FULL-<product_type>-API-001" },
    "step-out-partial": { "case": "TC-TRADE-STEP-OUT-PARTIAL-<product_type>-API-001" },
    "partial-termination": { "case": "TC-TRADE-PARTIAL-TERMINATION-<product_type>-API-001" },
    "portfolio-reassignment": { "case": "TC-TRADE-PORTFOLIO-REASSIGNMENT-<product_type>-API-001" }
  }
}
